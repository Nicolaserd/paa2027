      "bin": "powerbi-report-author",
      "repo": "github.com/microsoft/skills-for-fabric",
      "versionVerificada": "0.5.0",
      "nodeMinimo": "20"
    },
    {
      "id": "desktop-bridge-cli",
      "nombre": "Power BI Desktop Bridge CLI",
      "nombreOficial": "@microsoft/powerbi-desktop-bridge-cli (comando powerbi-desktop)",
      "tipo": "Herramienta CLI",
      "prioridad": "recomendada",
      "npm": "@microsoft/powerbi-desktop-bridge-cli",
      "bin": "powerbi-desktop",
      "repo": "github.com/microsoft/skills-for-fabric",
      "versionVerificada": "1.0.0",
      "nodeMinimo": "20"
    },
    {
      "id": "skill-semantic-model-authoring",
      "nombre": "semantic-model-authoring",
      "tipo": "Skill incluida en el plugin",
      "prioridad": "incluida",
      "skill": "semantic-model-authoring"
    },
    {
      "id": "skill-powerbi-report-cli",
      "nombre": "Power BI Report skill",
      "nombreOficial": "powerbi-report-cli (unifica las antiguas report skills: planning, design, authoring, management)",
      "tipo": "Skill incluida en el plugin",
      "prioridad": "incluida",
      "skill": "powerbi-report-cli"
    }
  ],

